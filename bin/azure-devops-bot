#!/usr/bin/env node

// This wrapper allows the azure-devops-bot command to work globally
// It uses tsx to execute the TypeScript source directly

import { spawn } from 'child_process';
import { fileURLToPath } from 'url';
import { dirname, join } from 'path';
import { existsSync } from 'fs';

const __filename = fileURLToPath(import.meta.url);
const __dirname = dirname(__filename);
const indexPath = join(__dirname, '..', 'src', 'cli-wrapper.ts');
const envPath = join(__dirname, '..', '.env');

// Build tsx command with env file if it exists
const tsxArgs = [];
if (existsSync(envPath)) {
  tsxArgs.push(`--env-file=${envPath}`);
}
tsxArgs.push(indexPath, ...process.argv.slice(2));

// Pass through all arguments to the actual CLI
const child = spawn('npx', ['tsx', ...tsxArgs], {
  stdio: 'inherit',
  shell: true,
  env: {
    ...process.env,
    // Set quiet environment variables BEFORE tsx loads any modules
    ...(process.argv.includes('--quiet') || process.argv.includes('-q') ? {
      LOG_SILENT: 'true',
      LOG_LEVEL: 'error',
      DOTENV_SILENT: 'true',
      SUPPRESS_NO_CONFIG_WARNING: 'true',
      NODE_ENV: 'production',
      DISABLE_DOTENV_LOGGING: 'true'
    } : {})
  }
});

child.on('exit', (code) => {
  process.exit(code || 0);
});