// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Person {
  // Primary key - Azure DevOps unique identifier
  id            String   @id // "fe71887b-c2c7-60bd-8688-00d137e0b5f5"
  
  // Core identity fields (from Azure DevOps AzureDevOpsPerson interface)
  displayName   String   // "Nathan Vale" 
  uniqueName    String   @unique // "Nathan.Vale@fwc.gov.au" (email - critical for queries)
  
  // Additional Azure DevOps fields (per DEC-003: store everything)
  url           String?  // "https://spsprodcus2.vssps.visualstudio.com/..."
  imageUrl      String?  // "https://dev.azure.com/..."  
  descriptor    String?  // "msa.ZmU3MTg4N2ItYzJjNy03MGJkLTg2ODg..."
  inactive      Boolean  @default(false) // Account status in Azure DevOps
  
  // Audit fields
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Relations - all person fields that reference this table
  assignedWorkItems     WorkItem[] @relation("AssignedTo")
  createdWorkItems      WorkItem[] @relation("CreatedBy") 
  changedWorkItems      WorkItem[] @relation("ChangedBy")
  closedWorkItems       WorkItem[] @relation("ClosedBy")
  resolvedWorkItems     WorkItem[] @relation("ResolvedBy")
  activatedWorkItems    WorkItem[] @relation("ActivatedBy")
  authorizedWorkItems   WorkItem[] @relation("AuthorizedAs")
  
  // Performance indexes (optimized for sub-100ms queries)
  @@index([uniqueName]) // PRIMARY: Email-based lookups (most common)
  @@index([displayName]) // SECONDARY: Display name searches  
  @@index([inactive]) // Filter active/inactive users
  @@index([uniqueName, inactive]) // COMPOUND: Active users by email
  @@index([displayName, inactive]) // COMPOUND: Active users by display name
  @@map("persons")
}

model WorkItem {
  id                Int      @id
  title             String
  state             String
  type              String
  assignedTo        String   @map("assigned_to") // Keep for backward compatibility during migration
  azureUrl          String   @map("azure_url")  // Will map to url in future migration
  description       String?
  
  // NEW: Person foreign key relationships (nullable during migration)
  assignedToId      String?  @map("assigned_to_id") 
  assignedToPerson  Person?  @relation("AssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  
  // Sprint/Board Info (for your reports)
  iterationPath     String?  @map("iteration_path") // e.g., "S3-Sprint 15"
  areaPath          String?  @map("area_path") // e.g., "Stage 3 Team"
  boardColumn       String?  @map("board_column") // e.g., "2. Build"
  boardColumnDone   Boolean  @default(false) @map("board_column_done")
  
  // Priority/Tags
  priority          Int?
  severity          String?
  tags              String?  // JSON array as string
  
  // All the dates
  createdDate       DateTime? @map("created_date")
  changedDate       DateTime? @map("changed_date") // For "Days Since Updated" 
  closedDate        DateTime? @map("closed_date")
  resolvedDate      DateTime? @map("resolved_date")
  activatedDate     DateTime? @map("activated_date")
  stateChangeDate   DateTime? @map("state_change_date")
  
  // People (Keep old String fields for backward compatibility during migration)
  createdBy         String?  @map("created_by")
  changedBy         String?  @map("changed_by")
  closedBy          String?  @map("closed_by")
  resolvedBy        String?  @map("resolved_by")
  
  // NEW: Additional Person foreign key relationships
  createdById       String?  @map("created_by_id")
  createdByPerson   Person?  @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  
  changedById       String?  @map("changed_by_id")
  changedByPerson   Person?  @relation("ChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  
  closedById        String?  @map("closed_by_id") 
  closedByPerson    Person?  @relation("ClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  
  resolvedById      String?  @map("resolved_by_id")
  resolvedByPerson  Person?  @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  
  // Work tracking
  storyPoints       Float?   @map("story_points")
  effort            Float?
  remainingWork     Float?   @map("remaining_work")
  completedWork     Float?   @map("completed_work")
  originalEstimate  Float?   @map("original_estimate")
  
  // Content
  acceptanceCriteria String? @map("acceptance_criteria")
  reproSteps         String? @map("repro_steps")
  systemInfo         String? @map("system_info")
  
  // Related items
  parentId          Int?     @map("parent_id")
  
  // Additional Azure DevOps fields
  rev               Int?
  reason            String?
  watermark         Int?
  
  // Required fields from review feedback
  url               String?  // Direct API URL
  commentCount      Int      @default(0) @map("comment_count")
  hasAttachments    Boolean  @default(false) @map("has_attachments")
  teamProject       String?  @map("team_project")
  areaId            Int?     @map("area_id")
  nodeId            Int?     @map("node_id")
  stackRank         Float?   @map("stack_rank")
  valueArea         String?  @map("value_area")
  
  // Additional fields for complete Azure DevOps coverage
  boardLane         String?  @map("board_lane")
  activatedBy       String?  @map("activated_by") // Keep for backward compatibility
  authorizedAs      String?  @map("authorized_as") // Keep for backward compatibility
  authorizedDate    DateTime? @map("authorized_date")
  
  // NEW: Additional Person foreign key relationships for activated and authorized
  activatedById     String?  @map("activated_by_id")
  activatedByPerson Person?  @relation("ActivatedBy", fields: [activatedById], references: [id], onDelete: SetNull)
  
  authorizedAsId    String?  @map("authorized_as_id")
  authorizedAsPerson Person?  @relation("AuthorizedAs", fields: [authorizedAsId], references: [id], onDelete: SetNull)
  revisedDate       DateTime? @map("revised_date")
  resolution        String?
  risk              String?
  businessValue     Float?   @map("business_value")
  timeCriticality   Float?   @map("time_criticality")
  
  // Store custom fields as JSON
  customFields      String?  @map("custom_fields") // JSON string
  
  // Store EVERYTHING from Azure DevOps (backup)
  rawJson           String   @map("raw_json")
  
  // Sync metadata
  lastUpdatedAt     DateTime @map("last_updated_at")
  lastSyncedAt      DateTime @default(now()) @map("last_synced_at")
  
  // Relations
  comments          WorkItemComment[]
  sourceRelations   WorkItemRelation[] @relation("SourceRelations")
  targetRelations   WorkItemRelation[] @relation("TargetRelations")
  links             WorkItemLink[]
  
  // Existing indexes (keep for backward compatibility)
  @@index([type])
  @@index([state])
  @@index([assignedTo])
  @@index([iterationPath])
  @@index([changedDate])
  @@index([createdDate])
  @@index([assignedTo, state])
  @@index([iterationPath, state])
  @@index([areaPath])
  @@index([boardColumn, boardColumnDone])
  @@index([parentId])
  @@index([type, state])
  @@index([priority, state])
  
  // NEW: Indexes for Person foreign key relationships
  @@index([assignedToId])
  @@index([createdById])
  @@index([changedById])
  @@index([closedById])
  @@index([resolvedById])
  @@index([activatedById])
  @@index([authorizedAsId])
  
  // NEW: Compound indexes for common query patterns (performance-critical)
  @@index([assignedToId, state]) // "my active work items"
  @@index([assignedToId, iterationPath]) // "my work items in current sprint"
  @@index([createdById, state]) // "work items I created"
  
  @@map("work_items")
}

model WorkItemComment {
  id           Int      @id // Azure DevOps comment ID (changed to Int)
  workItemId   Int      @map("work_item_id")
  text         String
  createdBy    String   @map("created_by")
  createdDate  DateTime @map("created_date")
  modifiedBy   String?  @map("modified_by")
  modifiedDate DateTime? @map("modified_date")
  
  workItem     WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  
  @@index([workItemId])
  @@map("work_item_comments")
}

model WorkItemRelation {
  id               Int    @id @default(autoincrement())
  sourceId         Int    @map("source_id")
  targetId         Int    @map("target_id")
  relationshipType String @map("relationship_type")
  attributes       String? // JSON string for additional metadata
  
  // Relations
  sourceWorkItem   WorkItem @relation("SourceRelations", fields: [sourceId], references: [id], onDelete: Cascade)
  targetWorkItem   WorkItem @relation("TargetRelations", fields: [targetId], references: [id], onDelete: Cascade)
  
  // Performance indexes
  @@index([sourceId])
  @@index([targetId])
  @@index([relationshipType])
  @@index([sourceId, relationshipType])
  @@index([targetId, relationshipType])
  @@map("work_item_relations")
}

model WorkItemLink {
  id           Int    @id @default(autoincrement())
  workItemId   Int    @map("work_item_id")
  linkType     String @map("link_type") // "ArtifactLink", "AttachedFile", etc.
  linkUrl      String @map("link_url")
  linkTitle    String @map("link_title") // Display name like "Pull Request", "Fixed in Commit"
  attributes   String? // JSON string for metadata (PR ID, commit hash, file info, etc.)
  
  // Relations
  workItem     WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  
  // Performance indexes
  @@index([workItemId])
  @@index([linkType])
  @@index([workItemId, linkType])
  @@map("work_item_links")
}

model SyncMetric {
  id            Int      @id @default(autoincrement())
  syncType      String   @map("sync_type") // "detailed", "basic", "comments"
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")
  durationMs    Int      @map("duration_ms")
  
  // Counts
  totalAttempted Int     @map("total_attempted")
  totalSucceeded Int     @map("total_succeeded")
  totalFailed    Int     @map("total_failed")
  successRate    Float   @map("success_rate")
  
  // Error summary
  totalErrors    Int     @map("total_errors")
  errorsByType   String  @map("errors_by_type") // JSON string
  
  // Performance metrics
  avgResponseTime Float? @map("avg_response_time")
  rateLimitHits   Int    @default(0) @map("rate_limit_hits")
  
  // Status
  status         String  @default("completed") // "completed", "failed", "partial"
  
  createdAt      DateTime @default(now()) @map("created_at")
  
  @@index([syncType])
  @@index([startTime])
  @@index([successRate])
  @@map("sync_metrics")
}